{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "formajs": ["node_modules/@getforma/core"],
      "@core/*": ["src/core/*"],
      "@platform/*": ["src/platform/*"],
      "@admin/*": ["src/admin/*"],
      "@tenant/*": ["src/tenant/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
