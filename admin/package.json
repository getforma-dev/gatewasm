{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx build.ts",
    "build:ssr": "tsx build.ts --ssr",
    "dev": "tsx build.ts --watch",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:rbac": "playwright test --grep @rbac",
    "test:ws": "playwright test --grep @ws",
    "test:visual": "playwright test --grep @visual",
    "test:a11y": "playwright test --grep @a11y",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:dev": "playwright test --config=playwright-dev.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@getforma/core": "^1.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@getforma/build": "^0.1.8",
    "@getforma/compiler": "^0.1.2",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/cli": "^4.1.0",
    "@types/node": "^25.5.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
